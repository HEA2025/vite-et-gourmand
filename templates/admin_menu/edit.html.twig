{% extends 'base.html.twig' %}

{% block title %}Modifier un menu - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1>Modifier le menu</h1>

    {{ form_start(form) }}

        {{ form_row(form.titre) }}
        {{ form_row(form.description) }}
        {{ form_row(form.nombreMinimumPersonnes) }}
        {{ form_row(form.prixMinimum) }}
        {{ form_row(form.conditions) }}
        {{ form_row(form.stock) }}
        {{ form_row(form.theme) }}
        {{ form_row(form.regime) }}
        {{ form_row(form.plats) }}

        <button type="submit">Enregistrer les modifications</button>

    {{ form_end(form) }}

    <p>
        <a href="{{ path('app_admin_menu_index') }}">
            Retour à la liste des menus
        </a>
    </p>

</div>
{% endblock %}