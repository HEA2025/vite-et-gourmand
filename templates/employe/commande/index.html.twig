{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">
        Gestion des commandes
    </h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-body">

            <h2 class="h5 mb-3">
                Rechercher une commande
            </h2>

            <form method="get" class="row g-3">

                <div class="col-md-5">
                    <label for="client" class="form-label">
                        Client
                    </label>

                    <input
                        type="text"
                        name="client"
                        id="client"
                        class="form-control"
                        value="{{ clientRecherche }}"
                        placeholder="Nom, prénom ou email"
                    >
                </div>

                <div class="col-md-5">
                    <label for="statut" class="form-label">
                        Statut
                    </label>

                    <select
                        name="statut"
                        id="statut"
                        class="form-select"
                    >
                        <option value="">
                            Tous les statuts
                        </option>

                        <option value="en attente"
                            {% if statutSelectionne == 'en attente' %}selected{% endif %}>
                            En attente
                        </option>

                        <option value="acceptée"
                            {% if statutSelectionne == 'acceptée' %}selected{% endif %}>
                            Acceptée
                        </option>

                        <option value="en préparation"
                            {% if statutSelectionne == 'en préparation' %}selected{% endif %}>
                            En préparation
                        </option>

                        <option value="en cours de livraison"
                            {% if statutSelectionne == 'en cours de livraison' %}selected{% endif %}>
                            En cours de livraison
                        </option>

                        <option value="livrée"
                            {% if statutSelectionne == 'livrée' %}selected{% endif %}>
                            Livrée
                        </option>

                        <option value="en attente du retour de matériel"
                            {% if statutSelectionne == 'en attente du retour de matériel' %}selected{% endif %}>
                            En attente du retour de matériel
                        </option>

                        <option value="terminée"
                            {% if statutSelectionne == 'terminée' %}selected{% endif %}>
                            Terminée
                        </option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button
                        type="submit"
                        class="btn btn-primary me-2"
                    >
                        Filtrer
                    </button>
                </div>

                <div class="col-12">
                    <a
                        href="{{ path('app_employe_commande_index') }}"
                        class="btn btn-outline-secondary"
                    >
                        Réinitialiser les filtres
                    </a>
                </div>

            </form>

        </div>
    </div>

    {% if commandes is empty %}

        <div class="alert alert-info">
            Aucune commande trouvée.
        </div>

    {% else %}

        <div class="table-responsive">

            <table class="table table-striped align-middle">

                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Client</th>
                        <th>Email</th>
                        <th>Menu</th>
                        <th>Date</th>
                        <th>Personnes</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                {% for commande in commandes %}

                    {% set dernierHistorique = null %}

                    {% for historique in commande.historiqueStatutCommandes %}

                        {% if dernierHistorique is null
                            or historique.dateModification > dernierHistorique.dateModification %}

                            {% set dernierHistorique = historique %}

                        {% endif %}

                    {% endfor %}

                    <tr>

                        <td>
                            {{ commande.id }}
                        </td>

                        <td>
                            {{ commande.utilisateur.prenom }}
                            {{ commande.utilisateur.nom }}
                        </td>

                        <td>
                            {{ commande.utilisateur.email }}
                        </td>

                        <td>
                            {{ commande.menu.titre }}
                        </td>

                        <td>
                            {{ commande.datePrestation|date('d/m/Y') }}
                        </td>

                        <td>
                            {{ commande.nombrePersonnes }}
                        </td>

                        <td>
                            {{ commande.prixTotal|number_format(2, ',', ' ') }} €
                        </td>

                        <td>

                            {% if dernierHistorique %}

                                <span class="badge text-bg-secondary">
                                    {{ dernierHistorique.statut }}
                                </span>

                            {% else %}

                                <span class="badge text-bg-warning">
                                    En attente
                                </span>

                            {% endif %}

                        </td>

                        <td>
                            <a
                                href="{{ path(
                                    'app_employe_commande_show',
                                    {id: commande.id}
                                ) }}"
                                class="btn btn-sm btn-primary"
                            >
                                Voir
                            </a>
                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    {% endif %}

</div>
{% endblock %}