{% extends 'base.html.twig' %}

{% block title %}{{ menu.titre }} - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1>{{ menu.titre }}</h1>

    <p>{{ menu.description }}</p>

    <p><strong>Thème :</strong> {{ menu.theme.nom }}</p>
    <p><strong>Régime :</strong> {{ menu.regime.nom }}</p>

    <p>
        <strong>Prix :</strong>
        {{ menu.prixMinimum|number_format(2, ',', ' ') }} €
    </p>

    <p>
        <strong>Nombre minimum de personnes :</strong>
        {{ menu.nombreMinimumPersonnes }}
    </p>

    <p>
        <strong>Stock :</strong>
        {{ menu.stock }}
    </p>

    {# Les conditions du menu doivent être clairement visibles avant la commande. #}
    <div class="alert alert-warning">
        <strong>Conditions du menu :</strong>
        {{ menu.conditions }}
    </div>

    <h2>Galerie d'images</h2>

    <div>
        {% for image in menu.imageMenus %}
            <img
                src="/images/menus/{{ image.nomFichier }}"
                alt="{{ menu.titre }}"
                width="300"
            >
        {% else %}
            <p>Aucune image pour ce menu.</p>
        {% endfor %}
    </div>

    <h2>Composition du menu</h2>

    {% for plat in menu.plats %}
        <div>
            <h3>{{ plat.nom }}</h3>

            <p>
                <strong>Type :</strong>
                {{ plat.type }}
            </p>

            <p>{{ plat.description }}</p>

            <p>
                <strong>Allergènes :</strong>

                {% if plat.allergenes is empty %}
                    Aucun
                {% else %}
                    {% for allergene in plat.allergenes %}
                        {{ allergene.nom }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% endif %}
            </p>
        </div>
    {% else %}
        <p>Aucun plat dans ce menu.</p>
    {% endfor %}

    <hr>

    {# Le menu est transmis dans l'URL pour préremplir la commande. #}
    {% if menu.stock > 0 %}
        <a
            href="{{ path('app_commande_new', {'id': menu.id}) }}"
            class="btn btn-primary"
        >
            Commander ce menu
        </a>
    {% else %}
        <p>
            <strong>Ce menu n'est actuellement plus disponible.</strong>
        </p>
    {% endif %}

    <a
        href="{{ path('app_menu_index') }}"
        class="btn btn-outline-secondary"
    >
        Retour aux menus
    </a>

</div>
{% endblock %}