{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5">

    <header class="mb-4">
        <h1 class="mb-2">Nos menus</h1>
        <p class="lead mb-0">
            Découvrez nos menus et utilisez les filtres pour trouver celui qui correspond à vos besoins.
        </p>
    </header>

    {# Les filtres possèdent tous un label associé pour rester accessibles. #}
    <section class="card mb-5" aria-labelledby="titre-filtres">
        <div class="card-body">
            <h2 id="titre-filtres" class="h4 mb-4">Filtrer les menus</h2>

            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="filtre-theme" class="form-label">Thème</label>
                    <select id="filtre-theme" class="form-select">
                        <option value="">Tous les thèmes</option>

                        {% for theme in themes %}
                            <option value="{{ theme.id }}">
                                {{ theme.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="filtre-regime" class="form-label">Régime</label>
                    <select id="filtre-regime" class="form-select">
                        <option value="">Tous les régimes</option>

                        {% for regime in regimes %}
                            <option value="{{ regime.id }}">
                                {{ regime.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-6 col-lg-2">
                    <label for="filtre-prix-min" class="form-label">
                        Prix min.
                    </label>
                    <input
                        type="number"
                        id="filtre-prix-min"
                        class="form-control"
                        min="0"
                        step="1"
                        inputmode="decimal"
                    >
                </div>

                <div class="col-6 col-lg-2">
                    <label for="filtre-prix-max" class="form-label">
                        Prix max.
                    </label>
                    <input
                        type="number"
                        id="filtre-prix-max"
                        class="form-control"
                        min="0"
                        step="1"
                        inputmode="decimal"
                    >
                </div>

                <div class="col-12 col-lg-2">
                    <label for="filtre-personnes" class="form-label">
                        Personnes
                    </label>
                    <input
                        type="number"
                        id="filtre-personnes"
                        class="form-control"
                        min="1"
                        step="1"
                        inputmode="numeric"
                    >
                </div>
            </div>
        </div>
    </section>

    {#
        aria-live permet aux technologies d'assistance d'être informées
        lorsque les résultats sont remplacés par le filtre AJAX.
    #}
    <section
        id="liste-menus"
        aria-live="polite"
        aria-busy="false"
        aria-label="Résultats des menus"
    >
        {% if menus is empty %}
            <div class="alert alert-info" role="status">
                Aucun menu n'est actuellement disponible.
            </div>
        {% else %}
            <div class="row g-4">
                {% for menu in menus %}
                    <div class="col-12 col-md-6">
                        <article class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h2 class="h3 card-title">
                                    {{ menu.titre }}
                                </h2>

                                <p class="card-text">
                                    {{ menu.description }}
                                </p>

                                <dl class="row mb-4">
                                    <dt class="col-5">Thème</dt>
                                    <dd class="col-7">{{ menu.theme.nom }}</dd>

                                    <dt class="col-5">Régime</dt>
                                    <dd class="col-7">{{ menu.regime.nom }}</dd>

                                    <dt class="col-5">À partir de</dt>
                                    <dd class="col-7">
                                        {{ menu.prixMinimum|number_format(2, ',', ' ') }} €
                                    </dd>

                                    <dt class="col-5">Minimum</dt>
                                    <dd class="col-7">
                                        {{ menu.nombreMinimumPersonnes }} personnes
                                    </dd>

                                    <dt class="col-5">Stock</dt>
                                    <dd class="col-7">
                                        {% if menu.stock > 0 %}
                                            {{ menu.stock }}
                                        {% else %}
                                            Indisponible
                                        {% endif %}
                                    </dd>
                                </dl>

                                <div class="mt-auto">
                                    <a
                                        href="{{ path('app_menu_show', {'id': menu.id}) }}"
                                        class="btn btn-primary"
                                    >
                                        Voir le menu
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {# Le filtrage AJAX est géré dans un fichier JavaScript séparé. #}
    <script src="{{ asset('js/menus.js') }}" defer></script>
{% endblock %}