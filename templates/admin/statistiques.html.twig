{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Statistiques</h1>

            <a href="{{ path('app_admin') }}" class="btn btn-secondary">
                Retour à l'administration
            </a>
        </div>

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        <section class="mb-5" aria-labelledby="commandes-par-menu">
            <h2 id="commandes-par-menu">Nombre de commandes par menu</h2>

            <p class="text-muted">
                Ces données statistiques proviennent de MongoDB.
            </p>

            {% if statistiques is empty %}
                <div class="alert alert-info">
                    Aucune statistique disponible.
                </div>
            {% else %}
                {# Graphique simple permettant de comparer les menus. #}
                {% for statistique in statistiques %}
                    {% set largeur = maximumCommandes > 0
                        ? (statistique.nombre_commandes / maximumCommandes * 100)
                        : 0
                    %}

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <strong>{{ statistique.menu_titre }}</strong>

                            <span>
                                {{ statistique.nombre_commandes }}
                                commande{{ statistique.nombre_commandes > 1 ? 's' : '' }}
                            </span>
                        </div>

                        <div
                            class="progress"
                            role="progressbar"
                            aria-label="Commandes pour {{ statistique.menu_titre }}"
                            aria-valuenow="{{ statistique.nombre_commandes }}"
                            aria-valuemin="0"
                            aria-valuemax="{{ maximumCommandes }}"
                        >
                            <div
                                class="progress-bar"
                                style="width: {{ largeur }}%"
                            >
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </section>

        <section aria-labelledby="chiffre-affaires">
            <h2 id="chiffre-affaires">Chiffre d'affaires</h2>

            {# Les filtres utilisent une requête GET afin de pouvoir être facilement modifiés. #}
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label for="menu" class="form-label">Menu</label>

                    <select id="menu" name="menu" class="form-select">
                        <option value="">Tous les menus</option>

                        {% for menu in menus %}
                            <option
                                value="{{ menu.id }}"
                                {% if menuSelectionne == menu.id %}selected{% endif %}
                            >
                                {{ menu.titre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="date_debut" class="form-label">
                        Date de début
                    </label>

                    <input
                        type="date"
                        id="date_debut"
                        name="date_debut"
                        value="{{ dateDebut }}"
                        class="form-control"
                    >
                </div>

                <div class="col-md-3">
                    <label for="date_fin" class="form-label">
                        Date de fin
                    </label>

                    <input
                        type="date"
                        id="date_fin"
                        name="date_fin"
                        value="{{ dateFin }}"
                        class="form-control"
                    >
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Filtrer
                    </button>
                </div>
            </form>

            <div class="card">
                <div class="card-body">
                    <h3 class="h5 card-title">
                        Chiffre d'affaires correspondant
                    </h3>

                    <p class="display-6 mb-0">
                        {{ chiffreAffaires|number_format(2, ',', ' ') }} €
                    </p>
                </div>
            </div>

            <p class="mt-3">
                <a href="{{ path('app_admin_statistiques') }}">
                    Réinitialiser les filtres
                </a>
            </p>
        </section>
    </div>
{% endblock %}