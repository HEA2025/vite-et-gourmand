{% extends 'base.html.twig' %}

{% block title %}Créer un employé{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Créer un compte employé</h1>

        <p class="text-muted">
            Le nouveau compte recevra automatiquement le rôle employé.
        </p>

        {{ form_start(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword) }}

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Créer l'employé
                </button>

                <a href="{{ path('app_admin') }}" class="btn btn-secondary">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}