{% extends 'base.html.twig' %}

{% block title %}Modifier ma commande{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">
        Modifier la commande n°{{ commande.id }}
    </h1>

    <div class="alert alert-info">
        Menu choisi :
        <strong>{{ commande.menu.titre }}</strong>.
        Le choix du menu ne peut pas être modifié.
    </div>

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">

            {{ form_start(form) }}

                {{ form_widget(form) }}

                <button
                    type="submit"
                    class="btn btn-primary mt-3"
                >
                    Enregistrer les modifications
                </button>

                <a
                    href="{{ path(
                        'app_commande_show',
                        {id: commande.id}
                    ) }}"
                    class="btn btn-outline-secondary mt-3"
                >
                    Annuler
                </a>

            {{ form_end(form) }}

        </div>
    </div>

</div>
{% endblock %}