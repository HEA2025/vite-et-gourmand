{% extends 'base.html.twig' %}

{% block title %}Commander - {{ menu.titre }}{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">Commander : {{ menu.titre }}</h1>

    {# Les informations du compte sont affichées automatiquement. #}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Vos informations</h2>

            <p>
                <strong>Nom :</strong>
                {{ app.user.nom }}
            </p>

            <p>
                <strong>Prénom :</strong>
                {{ app.user.prenom }}
            </p>

            <p>
                <strong>Email :</strong>
                {{ app.user.email }}
            </p>

            <p>
                <strong>GSM :</strong>
                {{ app.user.telephone }}
            </p>
        </div>
    </div>

    {# Le menu provient du bouton "Commander" de sa page détaillée. #}
    <div class="card mb-4">
        <div class="card-body">

            <h2 class="h5">Menu sélectionné</h2>

            <p><strong>{{ menu.titre }}</strong></p>

            <p>{{ menu.description }}</p>

            <p>
                <strong>Prix minimum :</strong>
                {{ menu.prixMinimum|number_format(2, ',', ' ') }} €
                pour {{ menu.nombreMinimumPersonnes }} personnes
            </p>

            {# Les conditions doivent rester visibles avant la validation. #}
            <div class="alert alert-warning">
                <strong>Conditions :</strong>
                {{ menu.conditions }}
            </div>

        </div>
    </div>

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">

                    <h2 class="h5 mb-3">
                        Informations de la prestation
                    </h2>

                    {{ form_start(form) }}

                        {{ form_widget(form) }}

                        {# Le serveur recalcule toujours le prix avant l'enregistrement. #}
                        <button
                            type="submit"
                            class="btn btn-primary mt-3"
                        >
                            Confirmer la commande
                        </button>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card"
                 id="detail-prix"
                 data-prix-minimum="{{ menu.prixMinimum }}"
                 data-nombre-minimum="{{ menu.nombreMinimumPersonnes }}">
                <div class="card-body">

                    <h2 class="h5 mb-3">
                        Détail du prix
                    </h2>

                    <p>
                        Prix du menu :
                        <strong id="prix-menu">
                            {{ menu.prixMinimum|number_format(2, ',', ' ') }} €
                        </strong>
                    </p>

                    <p>
                        Réduction :
                        <strong id="reduction-prix">
                            0,00 €
                        </strong>
                    </p>

                    <p>
                        Frais de livraison :
                        <strong id="frais-livraison">
                            0,00 €
                        </strong>
                    </p>

                    <hr>

                    <p class="fs-5">
                        Total :
                        <strong id="prix-total">
                            {{ menu.prixMinimum|number_format(2, ',', ' ') }} €
                        </strong>
                    </p>

                    <small>
                        La réduction de 10 % s'applique à partir de
                        {{ menu.nombreMinimumPersonnes + 5 }} personnes.
                    </small>

                </div>
            </div>
        </div>

    </div>

</div>
{% endblock %}

{% block javascripts %}
    {# Aperçu du prix en direct : le code est dans public/js/commande.js #}
    <script src="{{ asset('js/commande.js') }}" defer></script>
{% endblock %}
