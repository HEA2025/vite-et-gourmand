{% extends 'base.html.twig' %}

{% block title %}Commande n°{{ commande.id }}{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Commande n°{{ commande.id }}</h1>

        <a
            href="{{ path('app_commande_index') }}"
            class="btn btn-outline-secondary"
        >
            Mes commandes
        </a>
    </div>

    {# Affiche les messages après une modification ou une annulation. #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row g-4">

        {# Partie gauche : informations principales de la commande. #}
        <div class="col-lg-6">

            <div class="card">
                <div class="card-body">

                    <h2 class="h4 mb-3">
                        Détail de la commande
                    </h2>

                    <p>
                        <strong>Menu :</strong>
                        {{ commande.menu.titre }}
                    </p>

                    <p>
                        <strong>Adresse :</strong>
                        {{ commande.adressePrestation }}
                    </p>

                    <p>
                        <strong>Date :</strong>
                        {{ commande.datePrestation|date('d/m/Y') }}
                    </p>

                    <p>
                        <strong>Heure :</strong>
                        {{ commande.heureLivraison|date('H:i') }}
                    </p>

                    <p>
                        <strong>Nombre de personnes :</strong>
                        {{ commande.nombrePersonnes }}
                    </p>

                    <hr>

                    <p>
                        <strong>Prix menu :</strong>
                        {{ commande.prixMenu|number_format(2, ',', ' ') }} €
                    </p>

                    <p>
                        <strong>Réduction :</strong>
                        {{ commande.reduction|number_format(2, ',', ' ') }} €
                    </p>

                    <p>
                        <strong>Livraison :</strong>
                        {{ commande.fraisLivraison|number_format(2, ',', ' ') }} €
                    </p>

                    <p class="fs-5">
                        <strong>Total :</strong>
                        {{ commande.prixTotal|number_format(2, ',', ' ') }} €
                    </p>

                    <hr>

                    <p>
                        <strong>Statut actuel :</strong>
                        {{ statutActuel }}
                    </p>

                </div>
            </div>

            {#
                Le client peut modifier ou annuler uniquement
                tant que la commande est "en attente".
            #}
            {% if modifiable %}

                <div class="mt-3">

                    <a
                        href="{{ path(
                            'app_commande_edit',
                            {id: commande.id}
                        ) }}"
                        class="btn btn-warning"
                    >
                        Modifier la commande
                    </a>

                    <form
                        method="post"
                        action="{{ path(
                            'app_commande_delete',
                            {id: commande.id}
                        ) }}"
                        class="d-inline"
                        onsubmit="return confirm(
                            'Voulez-vous vraiment annuler cette commande ?'
                        );"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token(
                                'annuler_commande_' ~ commande.id
                            ) }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-danger"
                        >
                            Annuler la commande
                        </button>
                    </form>

                </div>

            {% else %}

                <div class="alert alert-info mt-3">

                    {% if statutActuel == 'annulée' %}

                        Cette commande a été annulée.
                        Elle ne peut plus être modifiée.

                    {% else %}

                        Cette commande a été prise en charge.
                        Elle ne peut plus être modifiée ou annulée.

                    {% endif %}

                </div>

            {% endif %}

        </div>

        {# Partie droite : suivi complet de la commande. #}
        <div class="col-lg-6">

            <div class="card">
                <div class="card-body">

                    <h2 class="h4 mb-3">
                        Suivi de la commande
                    </h2>

                    {% if commande.historiqueStatutCommandes is empty %}

                        <p>
                            Aucun historique disponible.
                        </p>

                    {% else %}

                        <ul class="list-group">

                            {% for historique in commande.historiqueStatutCommandes %}

                                <li class="list-group-item">

                                    <strong>
                                        {{ historique.statut }}
                                    </strong>

                                    <br>

                                    <small class="text-muted">
                                        {{ historique.dateModification|date(
                                            'd/m/Y à H:i'
                                        ) }}
                                    </small>

                                </li>

                            {% endfor %}

                        </ul>

                    {% endif %}

                </div>
            </div>

        </div>

    </div>

    {#
        L'avis devient accessible uniquement après la fin
        de la prestation.
    #}
    {% if statutActuel == 'terminée' %}

        <div class="card mt-4">
            <div class="card-body">

                <h2 class="h4">
                    Votre avis
                </h2>

                {% if commande.avis %}

                    {# Un seul avis est autorisé par commande. #}
                    <p>
                        <strong>Note :</strong>
                        {{ commande.avis.note }}/5
                    </p>

                    <p>
                        {{ commande.avis.commentaire }}
                    </p>

                    <p>
                        <strong>Statut :</strong>
                        {{ commande.avis.statut }}
                    </p>

                {% else %}

                    <p>
                        Votre prestation est terminée.
                        Vous pouvez maintenant donner votre avis.
                    </p>

                    <a
                        href="{{ path(
                            'app_avis_new',
                            {id: commande.id}
                        ) }}"
                        class="btn btn-primary"
                    >
                        Donner mon avis
                    </a>

                {% endif %}

            </div>
        </div>

    {% endif %}

</div>
{% endblock %}