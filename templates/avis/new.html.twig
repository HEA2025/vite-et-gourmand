{% extends 'base.html.twig' %}

{% block title %}Donner mon avis{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">Donner mon avis</h1>

    <div class="card mb-4">
        <div class="card-body">
            <p>
                <strong>Commande :</strong>
                n°{{ commande.id }}
            </p>

            <p>
                <strong>Menu :</strong>
                {{ commande.menu.titre }}
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            {{ form_start(form) }}

                {{ form_widget(form) }}

                <button
                    type="submit"
                    class="btn btn-primary mt-3"
                >
                    Envoyer mon avis
                </button>

                <a
                    href="{{ path(
                        'app_commande_show',
                        {id: commande.id}
                    ) }}"
                    class="btn btn-outline-secondary mt-3"
                >
                    Retour
                </a>

            {{ form_end(form) }}

        </div>
    </div>

</div>
{% endblock %}