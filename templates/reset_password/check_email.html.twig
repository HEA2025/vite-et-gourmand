{% extends 'base.html.twig' %}

{% block title %}E-mail envoyé - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h2 text-center mb-4">
                        Vérifiez votre messagerie
                    </h1>

                    {#
                        Le message ne confirme pas l'existence du compte.
                        Cela évite de révéler les adresses inscrites sur le site.
                    #}
                    <div class="alert alert-info" role="status">
                        Si un compte correspond à l'adresse indiquée, un e-mail
                        contenant un lien de réinitialisation vient d'être envoyé.
                    </div>

                    <p>
                        Ce lien expirera dans
                        <strong>
                            {{ resetToken.expirationMessageKey|trans(
                                resetToken.expirationMessageData,
                                'ResetPasswordBundle'
                            ) }}
                        </strong>.
                    </p>

                    <p>
                        Si vous ne recevez pas l'e-mail, vérifiez votre dossier
                        de courriers indésirables.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <a
                            href="{{ path('app_forgot_password_request') }}"
                            class="btn btn-primary"
                        >
                            Réessayer
                        </a>

                        <a
                            href="{{ path('app_login') }}"
                            class="btn btn-outline-secondary"
                        >
                            Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}