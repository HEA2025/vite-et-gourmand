{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h2 text-center mb-3">
                        Choisir un nouveau mot de passe
                    </h1>

                    <p class="text-body-secondary mb-4">
                        Saisissez votre nouveau mot de passe puis confirmez-le.
                    </p>

                    {{ form_start(resetForm) }}

                        {#
                            plainPassword est un RepeatedType :
                            Symfony génère le mot de passe et sa confirmation.
                        #}
                        {{ form_row(resetForm.plainPassword, {
                            row_attr: {
                                class: 'mb-3'
                            }
                        }) }}

                        <p class="form-text mb-4">
                            Le mot de passe doit contenir au moins 10 caractères,
                            avec une majuscule, une minuscule, un chiffre et un
                            caractère spécial.
                        </p>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Enregistrer le nouveau mot de passe
                            </button>
                        </div>

                    {{ form_end(resetForm) }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}