{% extends 'base.html.twig' %}

{% block title %}Inscription - Vite & Gourmand{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">

            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h2 text-center mb-3">Créer un compte</h1>

                    <p class="text-center text-body-secondary mb-4">
                        Créez votre compte pour pouvoir passer et suivre vos commandes.
                    </p>

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}

                        <div class="row">
                            <div class="col-12 col-md-6">
                                {{ form_row(registrationForm.nom, {
                                    label: 'Nom',
                                    attr: {
                                        class: 'form-control',
                                        autocomplete: 'family-name'
                                    },
                                    row_attr: {
                                        class: 'mb-3'
                                    }
                                }) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_row(registrationForm.prenom, {
                                    label: 'Prénom',
                                    attr: {
                                        class: 'form-control',
                                        autocomplete: 'given-name'
                                    },
                                    row_attr: {
                                        class: 'mb-3'
                                    }
                                }) }}
                            </div>
                        </div>

                        {{ form_row(registrationForm.telephone, {
                            label: 'Téléphone',
                            attr: {
                                class: 'form-control',
                                autocomplete: 'tel'
                            },
                            row_attr: {
                                class: 'mb-3'
                            }
                        }) }}

                        {{ form_row(registrationForm.adresse, {
                            label: 'Adresse postale',
                            attr: {
                                class: 'form-control',
                                autocomplete: 'street-address'
                            },
                            row_attr: {
                                class: 'mb-3'
                            }
                        }) }}

                        {{ form_row(registrationForm.email, {
                            label: 'Adresse e-mail',
                            attr: {
                                class: 'form-control',
                                autocomplete: 'email'
                            },
                            row_attr: {
                                class: 'mb-3'
                            }
                        }) }}

                        <div class="mb-2">
                            {{ form_row(registrationForm.plainPassword, {
                                label: 'Mot de passe',
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <p class="form-text mb-4">
                            Le mot de passe doit contenir au moins 10 caractères,
                            avec une majuscule, une minuscule, un chiffre et un
                            caractère spécial.
                        </p>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Créer mon compte
                            </button>
                        </div>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <p class="text-center mb-0">
                        Vous avez déjà un compte ?
                        <a href="{{ path('app_login') }}">
                            Se connecter
                        </a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}